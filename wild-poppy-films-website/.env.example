# Copy to .env.local and fill in. .env.local is gitignored.

# EmailJS - powers the form on /contact-us.
# Dashboard: https://dashboard.emailjs.com
# These are NEXT_PUBLIC_*, so they are visible in the browser bundle. That is how
# EmailJS is designed to work; restrict usage in the EmailJS dashboard by allowed
# domain rather than relying on these being secret.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Canonical origin, used for metadata, Open Graph URLs, sitemap.xml and robots.txt.
# Leave unset locally; set it in the Vercel project settings for production.
NEXT_PUBLIC_SITE_URL=https://wildpoppyfilms.com
